---
// Motion-design scenes that replace the old generated images.
// Pure inline SVG/HTML + CSS (see styles/scenes.css). No raster assets.
interface Props { name: string }
const { name } = Astro.props;
const bars = [10, 22, 14, 30, 18, 12, 26, 16, 34, 20, 12, 24, 14, 18];
---
<div class={`scene sc-${name}`} aria-hidden="true">
  {name === 'voice' && (
    <svg viewBox="0 0 300 225">
      <circle cx="46" cy="76" r="17" class="fillAccent" />
      <polygon points="41,68 41,84 55,76" class="fillWhite" />
      {bars.map((h, i) => (
        <rect class="bar" x={78 + i * 14} y={76 - h / 2} width="6" height={h} rx="3" style={`--d:${i * 70}ms`} />
      ))}
      <rect class="line l1" x="30" y="128" width="236" height="9" rx="4.5" />
      <rect class="line l2" x="30" y="148" width="196" height="9" rx="4.5" />
      <rect class="line l3" x="30" y="168" width="130" height="9" rx="4.5" />
    </svg>
  )}

  {name === 'focus' && (
    <svg viewBox="0 0 300 225">
      {[0, 1, 2, 3, 4].map((i) => (
        <g class={i === 0 ? 'row fav' : 'row quiet'} style={`--i:${i}`} transform={`translate(0 ${24 + i * 38})`}>
          <rect x="24" y="0" width="252" height="30" rx="10" class="rowBg" />
          <circle cx="44" cy="15" r="9" class={i === 0 ? 'fillAccent' : 'fillMute'} />
          <rect x="62" y="9" width={i === 0 ? 120 : 90 + (i % 2) * 30} height="5" rx="2.5" class="lineBase" />
          <rect x="62" y="19" width="70" height="4" rx="2" class="lineBase soft" />
          <circle cx="256" cy="15" r="6" class="ping" />
        </g>
      ))}
      <circle cx="256" cy="39" r="6" class="ring" />
    </svg>
  )}

  {name === 'multi' && (
    <svg viewBox="0 0 300 225">
      <rect x="86" y="24" width="190" height="177" rx="14" class="panel" />
      {['S', 'E', 'N'].map((ch, i) => (
        <g transform={`translate(24 ${46 + i * 52})`}>
          <circle cx="20" cy="20" r="20" class="avatar" />
          <text x="20" y="26" text-anchor="middle" class="avatarText">{ch}</text>
          <circle cx="20" cy="20" r="24" class={`ringSel r${i}`} />
        </g>
      ))}
      {[0, 1, 2].map((i) => (
        <g class={`chat c${i}`}>
          <rect x="104" y="46" width={110 + i * 20} height="22" rx="11" class="lineBase soft" />
          <rect x={196 - i * 14} y="84" width={80 + i * 14} height="22" rx="11" class="fillAccentSoft" />
          <rect x="104" y="122" width={130 - i * 18} height="22" rx="11" class="lineBase soft" />
          <rect x={176} y="158" width="80" height="22" rx="11" class="fillAccentSoft" />
        </g>
      ))}
    </svg>
  )}

  {name === 'privacy' && (
    <svg viewBox="0 0 300 225">
      <g class="cloud">
        <circle cx="244" cy="96" r="16" /><circle cx="262" cy="104" r="13" /><circle cx="228" cy="106" r="12" />
        <rect x="222" y="104" width="52" height="12" rx="6" />
        <line x1="216" y1="130" x2="278" y2="78" class="slash" />
      </g>
      <rect x="40" y="62" width="120" height="92" rx="14" class="device" />
      <rect x="52" y="74" width="96" height="6" rx="3" class="lineBase soft" />
      <rect x="86" y="108" width="28" height="22" rx="5" class="fillAccent" />
      <path d="M92 108 v-7 a8 8 0 0 1 16 0 v7" class="lockArc" />
      <line x1="184" y1="50" x2="184" y2="166" class="barrier" />
      <circle cx="160" cy="108" r="4.5" class="packet p1" />
      <circle cx="160" cy="108" r="4.5" class="packet p2" />
      <circle cx="160" cy="108" r="4.5" class="packet p3" />
    </svg>
  )}

  {name === 'native' && (
    <svg viewBox="0 0 300 225">
      <text x="28" y="44" class="tiny">Memory</text>
      <rect x="28" y="52" width="244" height="14" rx="7" class="track" />
      <rect x="28" y="52" width="244" height="14" rx="7" class="fill fast" />
      <rect x="28" y="76" width="244" height="14" rx="7" class="track" />
      <rect x="28" y="76" width="244" height="14" rx="7" class="fill slow" />
      <text x="28" y="136" class="tiny">Startup</text>
      <rect x="28" y="144" width="244" height="14" rx="7" class="track" />
      <rect x="28" y="144" width="244" height="14" rx="7" class="fill fast b2" />
      <rect x="28" y="168" width="244" height="14" rx="7" class="track" />
      <rect x="28" y="168" width="244" height="14" rx="7" class="fill slow b2" />
    </svg>
  )}

  {name === 'summaries' && (
    <svg viewBox="0 0 300 225">
      {[0, 1, 2, 3, 4, 5].map((i) => (
        <rect class="stream" style={`--i:${i}`} x={i % 2 ? 60 : 28} y={24 + i * 20} width={150 + ((i * 37) % 70)} height="11" rx="5.5" />
      ))}
      <g class="digest">
        <rect x="28" y="150" width="244" height="58" rx="14" class="digestBg" />
        <rect x="44" y="164" width="150" height="7" rx="3.5" class="fillAccent" />
        <rect x="44" y="178" width="196" height="6" rx="3" class="lineBase" />
        <rect x="44" y="190" width="120" height="6" rx="3" class="lineBase" />
      </g>
    </svg>
  )}

  {name === 'agent' && (
    <div class="term">
      <div class="termBar"><i></i><i></i><i></i><b>agent key · read, send</b></div>
      <div class="termBody">
        <p class="t1">$ GET /v1/chats?unread=1</p>
        <p class="t2">{'{ "unread": 3, "scope": "read" }'}</p>
        <p class="t3">$ POST /v1/messages</p>
        <p class="t4">{'{ "sent": true }'}<span class="caret"></span></p>
      </div>
    </div>
  )}

  {name === 'selfhost' && (
    <svg viewBox="0 0 300 225">
      {[0, 1, 2].map((i) => (
        <g transform={`translate(28 ${50 + i * 44})`}>
          <rect width="88" height="34" rx="8" class="device" />
          <circle cx="14" cy="17" r="3.5" class="led" style={`--d:${i * 420}ms`} />
          <rect x="28" y="14" width="46" height="5" rx="2.5" class="lineBase soft" />
        </g>
      ))}
      <line x1="122" y1="112" x2="178" y2="112" class="wire" />
      <circle cx="122" cy="112" r="4.5" class="packet k1" />
      <circle cx="122" cy="112" r="4.5" class="packet k2" />
      <rect x="182" y="78" width="92" height="60" rx="8" class="device" />
      <rect x="190" y="86" width="76" height="44" rx="4" class="screen" />
      <rect x="168" y="142" width="120" height="7" rx="3.5" class="lineBase" />
    </svg>
  )}

  {name === 'modes' && (
    <svg viewBox="0 0 300 225">
      <rect x="22" y="40" width="124" height="140" rx="16" class="panel" />
      <rect x="154" y="40" width="124" height="140" rx="16" class="panel" />
      <rect x="22" y="40" width="124" height="140" rx="16" class="pick" />
      <rect x="40" y="64" width="88" height="62" rx="10" class="device" />
      <rect x="54" y="78" width="60" height="16" rx="5" class="fillAccent" />
      <rect x="54" y="100" width="40" height="8" rx="4" class="lineBase soft" />
      <rect x="172" y="64" width="40" height="26" rx="7" class="device" />
      <rect x="226" y="100" width="40" height="26" rx="7" class="fillAccentSoft" />
      <line x1="212" y1="82" x2="226" y2="108" class="wire" />
      <text x="84" y="158" text-anchor="middle" class="tiny">In the app</text>
      <text x="216" y="158" text-anchor="middle" class="tiny">Self-hosted</text>
    </svg>
  )}

  {name === 'mac' && (
    <svg viewBox="0 0 300 180">
      <rect x="62" y="26" width="176" height="112" rx="12" class="device" />
      <circle cx="78" cy="42" r="3.5" class="dotA" /><circle cx="90" cy="42" r="3.5" class="dotB" /><circle cx="102" cy="42" r="3.5" class="dotC" />
      <rect x="76" y="62" width="70" height="7" rx="3.5" class="lineBase soft" />
      <rect x="76" y="78" width="110" height="7" rx="3.5" class="lineBase soft" />
      <g class="arrow"><circle cx="212" cy="96" r="16" class="fillAccent" /><path d="M212 88 v14 m-6 -6 l6 7 l6 -7" class="stroke" /></g>
      <rect x="112" y="146" width="76" height="6" rx="3" class="lineBase soft" />
    </svg>
  )}

  {name === 'windows' && (
    <svg viewBox="0 0 300 180">
      <rect x="62" y="26" width="176" height="112" rx="6" class="device" />
      <g class="panes">
        <rect x="84" y="50" width="30" height="30" rx="3" /><rect x="118" y="50" width="30" height="30" rx="3" />
        <rect x="84" y="84" width="30" height="30" rx="3" /><rect x="118" y="84" width="30" height="30" rx="3" />
      </g>
      <g class="arrow"><circle cx="198" cy="96" r="16" class="fillAccent" /><path d="M198 88 v14 m-6 -6 l6 7 l6 -7" class="stroke" /></g>
      <rect x="86" y="146" width="128" height="6" rx="3" class="lineBase soft" />
    </svg>
  )}

  {name === 'linux' && (
    <div class="term small">
      <div class="termBar"><i></i><i></i><i></i><b>~ $</b></div>
      <div class="termBody">
        <p class="t1">$ sudo dpkg -i vasyapp.deb</p>
        <p class="t2">Setting up vasyapp …</p>
        <p class="t3">$ vasyapp<span class="caret"></span></p>
      </div>
    </div>
  )}

  {name === 'android' && (
    <svg viewBox="0 0 300 180">
      <rect x="112" y="12" width="76" height="156" rx="14" class="device" />
      <rect x="122" y="30" width="56" height="94" rx="5" class="screen" />
      <rect x="126" y="134" width="48" height="6" rx="3" class="track" />
      <rect x="126" y="134" width="48" height="6" rx="3" class="fill fast bar1" />
      <g class="arrow"><circle cx="150" cy="77" r="13" class="fillAccent" /><path d="M150 70 v12 m-5 -5 l5 6 l5 -6" class="stroke" /></g>
    </svg>
  )}

  {name === 'ios' && (
    <svg viewBox="0 0 300 180">
      <rect x="112" y="12" width="76" height="156" rx="16" class="device" />
      <rect x="136" y="18" width="28" height="6" rx="3" class="lineBase soft" />
      <rect x="122" y="34" width="56" height="94" rx="5" class="screen" />
      <circle cx="150" cy="81" r="14" class="soonRing" />
      <circle cx="150" cy="81" r="5" class="fillAccent soonDot" />
    </svg>
  )}

  {name === 'web' && (
    <svg viewBox="0 0 300 180">
      <rect x="54" y="26" width="192" height="116" rx="10" class="device" />
      <rect x="66" y="38" width="168" height="16" rx="8" class="screen" />
      <circle cx="78" cy="46" r="3" class="fillAccent" />
      <rect x="88" y="44" width="70" height="4" rx="2" class="lineBase soft" />
      <g class="globe">
        <circle cx="150" cy="98" r="26" class="globeRing" />
        <ellipse cx="150" cy="98" rx="11" ry="26" class="globeRing m1" />
        <ellipse cx="150" cy="98" rx="26" ry="10" class="globeRing" />
      </g>
    </svg>
  )}
</div>
